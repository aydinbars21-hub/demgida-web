# Dem Gida - ortam degiskenleri ornegi
#
# ONEMLI: Bu dosyanin gercek degerleri Vercel projesinde ZATEN girili.
# Siteyi yayina almak icin bu dosyayi doldurmaniza gerek YOK.
# Yalnizca projeyi kendi bilgisayarinizda calistirmak isterseniz gerekir.
#
# Gercek degerleri almak icin: Vercel panelinde
# Settings > Environment Variables ekranina bakin.
# "Sensitive" isaretli olanlar bir daha gosterilmez; onlari Supabase
# panelinizden yeniden alabilirsiniz.
#
# Bu dosyayi doldurduktan sonra adini .env.local yapin.

# Supabase (panel: Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Yonetim paneli
# ADMIN_ENCRYPTION_KEY: 64 haneli hex (32 bayt). DEGISTIRMEYIN:
# PayTR anahtarlari ve Google Authenticator bagi bu anahtarla sifreli.
# Degisirse panel kilitlenir ve kurulum bastan yapilmak zorunda kalir.
ADMIN_ENCRYPTION_KEY=
# ADMIN_SETUP_TOKEN: ilk kurulum sifresi. Kurulum bitince islevsiz kalir.
ADMIN_SETUP_TOKEN=

# E-posta (resend.com)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
# Kendi alan adinizi Resend'de dogruladiktan sonra burayi doldurun.
# Bos birakilirsa Resend'in paylasimli test adresi kullanilir ve
# gonderilen e-postalar buyuk ihtimalle spam'e duser.
SIPARIS_EPOSTA_GONDEREN=Dem Gida <siparis@demgida.com>

# Site adresi. PayTR geri donus adresleri bunun uzerinden kurulur.
NEXT_PUBLIC_APP_URL=https://www.demgida.com
